# Cardinal world -- a menagerie: two regions of very different climate, each home to an
# organism whose body heat responds to the temperature around it. Two domains (physical and
# living) meeting only through committed facts (Vol. III Ch. 12).

[manifest]
id = world.menagerie
version = 0.1.0
engine = >=0.0, <1.0
domains = physical, living

[clock]
# How much simulated time one tick lasts, and how long a day is (Vol. II Ch. 2, Amendment A-1).
# Every rate below is in simulated time, so changing the tick changes resolution, not behaviour.
tick_seconds = 3600
day_seconds = 86400

[rules.physical]
environment_step_seconds = 3600         # the environment steps once a simulated hour
diurnal_amplitude_centi_c = 400
temperature_variability_centi_c = 300   # weather's typical departure from normal: 3.00 C
weather_persistence_seconds = 21600     # a spell of weather lasts about six hours
illumination_peak = 10000
humidity_baseline = 5500
humidity_variability = 800              # typical departure: 8.00% relative humidity
pressure_sea_level = 10130
pressure_elevation_factor = 1
pressure_variability = 60               # typical departure: 6 hPa
wind_gradient_divisor = 10
fall_danger_per_meter = 1500        # danger points per metre of fall height
thermal_mass_reference = 1500       # material heat capacity (J/kg-K) that halves the swing

[rules.living]
metabolism_step_seconds = 3600   # metabolism steps once a simulated hour
set_point_centi_c = 3700         # 37.00 C metabolic set point
warm_response_seconds = 21600    # time constant of the pull toward the set point (6 h)
cold_response_seconds = 10800    # time constant of the pull toward ambient (3 h)

[regions]
# region_id = temperature[, elevation]
1 = -800, 240000             # a frigid alpine region, -8.00 C at 2400 m
2 = 2600, 10000              # a warm lowland region, 26.00 C at 100 m

[organisms]
# organism_id = region_id, starting body heat (centidegrees Celsius)
10 = 1, 3700
20 = 2, 3700

[containment]
# child_id = parent_id -- each region sits within continent 1000 (hierarchical containment)
1 = 1000
2 = 1000

[adjacency]
# region_a = region_b -- an undirected border between the alpine and lowland regions
1 = 2
