# Cardinal world package -- a small wilderness.
# Format: sectioned "key = value" text (Vol. IV Ch. 1). Data only; no executable content.

[manifest]
id = world.wilderness
version = 0.1.0
engine = >=0.0, <1.0
domains = physical

# Every tunable number lives in the package, never in engine code (Vol. IV Ch. 2, inv. 5).
[clock]
# How much simulated time one tick lasts, and how long a day is (Vol. II Ch. 2, Amendment A-1).
# Every rate below is in simulated time, so changing the tick changes resolution, not behaviour.
tick_seconds = 3600
day_seconds = 86400

[rules.physical]
environment_step_seconds = 3600         # the environment steps once a simulated hour
diurnal_amplitude_centi_c = 500
temperature_variability_centi_c = 300   # weather's typical departure from normal: 3.00 C
weather_persistence_seconds = 21600     # a spell of weather lasts about six hours
illumination_peak = 10000
humidity_baseline = 6000
humidity_variability = 800              # typical departure: 8.00% relative humidity
pressure_sea_level = 10130
pressure_elevation_factor = 1
pressure_variability = 60               # typical departure: 6 hPa
wind_gradient_divisor = 10
fall_danger_per_meter = 1500        # danger points per metre of fall height
thermal_mass_reference = 1500       # material heat capacity (J/kg-K) that halves the swing
gravity_cm_s2 = 981                 # 9.81 m/s2
step_height_cm = 40                 # a stair riser; anything taller is walked around
max_slope_percent = 100             # 45 degrees: the steepest ground walked over
nav_cell_cm = 50                    # how finely a walker finds its way around obstacles

# Initial reality: three regions -- temperature (centidegrees C) and elevation (centimetres).
[regions]
# region_id = temperature[, elevation]
1 = 1500, 20000
2 = 1800, 45000
3 = 2100, 5000
