# Cardinal world -- a cottage on a hillside, and a villager walking home.
#
# Exercises the world format for space as a text world needs it (Amendments A-1 to A-4): a
# clock with one-second ticks; a hillside with terrain; a cottage whose kitchen and loft are
# walled rooms joined by a ladder; a front door whose two faces are linked; a solid table in the
# way; and a villager who starts at the foot of the hill already meaning to go up to the loft.
# Nothing in the file moves the villager -- the [travel] line is an intent, and the engine finds
# the way: up the slope, through the door, around the table, up the ladder.
#
#   hillside (1), terrain rising east: 0 m at x = 0, 1 m at x = 10 m, 3 m from x = 20 m on
#   └── cottage (2), standing on the hill at (20 m, 10 m), 3 m up
#       ├── kitchen (3)  8 m x 6 m, door in the north wall, ladder in the south-east corner
#       └── loft    (4)  above the kitchen, 2.6 m up

[manifest]
id = world.cottage
version = 0.1.0
engine = >=0.0, <1.0
domains = physical

[clock]
tick_seconds = 1
day_seconds = 86400

[rules.physical]
environment_step_seconds = 60           # the weather steps once a simulated minute
diurnal_amplitude_centi_c = 500
temperature_variability_centi_c = 300
weather_persistence_seconds = 21600
illumination_peak = 10000
humidity_baseline = 6000
humidity_variability = 800
pressure_sea_level = 10130
pressure_elevation_factor = 1
pressure_variability = 60
wind_gradient_divisor = 10
fall_danger_per_meter = 1500
thermal_mass_reference = 1500
gravity_cm_s2 = 981
step_height_cm = 40
max_slope_percent = 100
nav_cell_cm = 50

# Places with weather (each carries a temperature, centidegrees C).
[regions]
1 = 1400     # the hillside
3 = 1900     # the kitchen
4 = 2000     # the loft

[containment]
2 = 1        # the cottage stands on the hillside
3 = 2        # the kitchen is in the cottage
4 = 2        # so is the loft
10 = 1       # the villager, out on the hillside
20 = 3       # the table, in the kitchen

[positions]
# entity = x, y[, z]  (cm, in the container's frame; a body's base)
2 = 2000, 1000, 300     # the cottage, on the hill where the ground is 3 m up
3 = 0, 0, 0             # the kitchen at the cottage's origin
4 = 0, 0, 260           # the loft above it
10 = 500, 1000, 50      # the villager, at the foot of the hill
20 = 150, 50            # the table, between the door and the ladder

# The hillside's ground: 10 m between samples, 4 columns to a row (x = 0, 10, 20, 30 m).
[terrain]
1 = 1000, 4, 0 100 300 300  0 100 300 300  0 100 300 300

[portals]
# portal = host, destination, x, y[, z]
1000 = 1, 3, 2000, 1300, 300   # the front door, outside (in the north wall)
1001 = 3, 1, 0, 300            # the front door, inside
1002 = 3, 4, 300, -200         # the ladder, at its foot in the kitchen
1003 = 4, 3, 300, -200         # the ladder, at its head in the loft

[portal_pairs]
1000 = 1001
1002 = 1003

[bodies]
# entity = half_width, half_depth, height (cm)
3 = 400, 300, 260       # kitchen: 8 m x 6 m, 2.6 m to the ceiling
4 = 400, 300, 200       # loft
1000 = 45, 10, 205      # the door: 90 cm wide
1001 = 45, 10, 205
1002 = 30, 30, 260      # the ladder's opening
1003 = 30, 30, 260
20 = 80, 50, 75         # the table: 1.6 m x 1 m, waist high
10 = 25, 15, 175        # the villager

[flags]
3 = enclosed
4 = enclosed
1000 = opaque           # a door hides what is behind it when shut
1001 = opaque
20 = solid
10 = mobile

[travel]
# entity = destination, speed (cm/s)
10 = 4, 120             # the villager is going home, up to the loft
