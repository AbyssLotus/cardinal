# Cardinal reference world -- Ashford, a city in the Vale.
#
# One fictional world in which every engine feature is exercised in context, instead of a small
# world per feature. It grew from the city where Alice, Bob, Carol, and Dave live (the old
# house world). The tests in tests/reference/ load it, give its people things to do, and ask
# the engine what became of them.
#
# Nesting -- each place lies in the one above; positions are local to their container:
#
#   the Reach (9)                      the outermost frame: a geological region, no climate
#   |-- the Vale (1)                   a climate: Ashford and everything in it inherits it
#   |   `-- Ashford (10)               the city
#   |       |-- Old Town (11)          Alice's house and yard; the manor
#   |       |-- the Hill (12)          terrain: a slope, a ridge with a cliff, a pass, a mine
#   |       |-- the Harbour (13)       a ship at its mooring
#   |       `-- Millside (14)          the farm, the wood, the mill (overlapping regions)
#   |-- Highmoor (2)                   a colder climate 400 m up, on granite
#   `-- Southfen (3)                   a warmer climate down in the fens
#
# Entity ids by range: 1-14 nesting; 100s Alice's house; 200s the Hill; 300s the manor;
# 400s the mine; 500s the harbour; 600s Millside; 700s materials; 900s overlapping regions;
# 1000s openings (portals); 2000s people, animals, and things that move.
#
# Units: centimetres, centidegrees C, hundredths of a percent, compass degrees.

[manifest]
id = world.ashford
version = 0.1.0
engine = >=0.0, <1.0
domains = physical, living, information, minds

[clock]
# A text world: one tick is one simulated second.
tick_seconds = 1
day_seconds = 86400

[rules.physical]
environment_step_seconds = 60       # the weather steps once a simulated minute
diurnal_amplitude_centi_c = 500
temperature_variability_centi_c = 300
weather_persistence_seconds = 21600
illumination_peak = 10000
humidity_baseline = 6000
humidity_variability = 800
pressure_sea_level = 10130
pressure_elevation_factor = 1
pressure_variability = 60
wind_gradient_divisor = 10
fall_danger_per_meter = 1500
thermal_mass_reference = 2000
gravity_cm_s2 = 981
step_height_cm = 40
max_slope_percent = 100
nav_cell_cm = 50
reach_cm = 75
indoor_coupling_seconds = 14400
sight_step_seconds = 1              # what each body can see, refreshed every second
sight_min_illumination = 50         # below 0.5% of full daylight, nothing can be made out

[rules.living]
metabolism_step_seconds = 60
set_point_centi_c = 3700
warm_response_seconds = 21600
cold_response_seconds = 10800

[rules.information]
perception_step_seconds = 1
warmth_resolution_centi_c = 50      # half a degree: the least change of warmth anyone notices

[rules.minds]
think_step_seconds = 5              # each mind weighs its choices every five seconds
cold_below_centi_c = 2300           # body heat below which a mind feels cold
trust_half_age_seconds = 172800     # a two-day-old memory is trusted half as much as a fresh one
hop_cost = 20                       # what each opening on the way costs a choice
routine_value = 300                 # what keeping a routine is worth
switch_margin = 100                 # how much better a new choice must be to change one's mind

# ---- The nesting -------------------------------------------------------------------------

# Climates: places with weather of their own (temperature, elevation). Everything nested inside
# one without its own inherits it. Walled rooms become indoor climates as the day begins.
[regions]
