# Cardinal world -- a farmstead: a county holding a farm (farmhouse + far field), a wood, and a
# mill, with four overlapping regions laid over that hierarchy. Demonstrates Vol. III Ch. 1
# §1.7: a location belongs to many regions at once, the regions need not nest inside one
# another or inside the containment tree, and a region may be discontiguous.
#
#   climate zone (900)  -- takes in the whole county
#   watershed    (901)  -- the farm and the mill drain to the creek; the wood drains the other way
#   fox territory(902)  -- the wood AND the farm's far field: it straddles the farm's boundary
#   frost hollow (903)  -- low ground where cold air pools: the far field and the mill, which
#                          do not border each other (a discontiguous region)

[manifest]
id = world.farmstead
version = 0.1.0
engine = >=0.0, <1.0
domains = physical

[rules.physical]
ticks_per_day = 24
diurnal_amplitude_centi_c = 500
weather_max_swing_centi_c = 50
illumination_peak = 10000
humidity_baseline = 6000
humidity_swing = 100
humidity_drying_divisor = 8
pressure_sea_level = 10130
pressure_elevation_factor = 1
pressure_weather_swing = 20
pressure_settle_divisor = 8
wind_gradient_divisor = 10
fall_danger_per_meter = 1500        # danger points per metre of fall height
thermal_mass_reference = 1500       # material heat capacity (J/kg-K) that halves the swing

# The places the weather runs on (each carries a temperature). The overlapping regions 900-903
# are NOT listed here: a classification region has no weather of its own -- it is the places
# that name it in [in_region].
[regions]
1 = 1400     # county
2 = 1500     # farm
3 = 1900     # farmhouse
4 = 1300     # far field
5 = 1200     # wood
6 = 1350     # mill

[containment]
# child = parent -- the one hierarchy (Vol. III Ch. 1 §1.8)
2 = 1        # farm in the county
3 = 2        # farmhouse on the farm
4 = 2        # far field on the farm
5 = 1        # wood in the county
6 = 1        # mill in the county
10 = 3       # the farmer, in the farmhouse
11 = 5       # the fox, in the wood
12 = 6       # the miller, in the mill

[adjacency]
2 = 5        # the farm borders the wood
5 = 6        # the wood borders the mill (the field and the mill do not touch)

[in_region]
# location = region[, region...] -- every grouping beyond the hierarchy (Vol. III Ch. 1 §1.7)
1 = 900          # the county lies in the temperate climate zone
2 = 901          # the farm drains to the creek
6 = 901, 903     # so does the mill, which also sits in the frost hollow
5 = 902          # the wood is the fox's territory...
4 = 902, 903     # ...and so is the far field, which is also frost-hollow ground
